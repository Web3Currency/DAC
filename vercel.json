{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/about/:path*", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/services/:path*", "destination": "/index.html" },
    { "source": "/properties", "destination": "/index.html" },
    { "source": "/properties/:path*", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/contact/:path*", "destination": "/index.html" },
    { "source": "/insights/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
