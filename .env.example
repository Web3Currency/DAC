# Public Supabase project configuration (safe for browser use).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side only. Required by the Vercel Blob media upload/delete API routes.
# Never prefix this token with VITE_ and never expose it to the browser.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Public canonical website origin used by deployment tooling, if needed.
APP_URL=https://demolaadetola.ng